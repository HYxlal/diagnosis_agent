# ============================================
# diagnosis_agent 环境变量配置
# 复制为 .env 并填入实际值
# ============================================

# 阿里云通义千问 API Key（DashScope）
DASHSCOPE_API_KEY="your-key-here"
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 模型（通义千问）
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Embedding 模型（通义千问 Embedding）
EMBEDDING_MODEL=text-embedding-v2

# InputRouter 意图分类模型（建议用轻量模型，降低成本）
INPUT_ROUTER_MODEL=qwen-turbo

# Neo4j 故障知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# 应用配置
APP_ENV=development
LOG_LEVEL=INFO
